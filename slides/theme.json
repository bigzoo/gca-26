{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#6B7A99", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#1B8E1B", "bold": true },
  "h1": { "prefix": "", "color": "#1B8E1B", "bold": true, "block_suffix": "\n" },
  "h2": { "prefix": "", "color": "#1B8E1B", "bold": true },
  "h3": { "prefix": "", "color": "#6B7A99", "bold": false },
  "h4": { "prefix": "", "color": "#6B7A99" },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#6B7A99", "format": "\n────────────────────────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#1B8E1B", "underline": true },
  "link_text": { "color": "#1B8E1B", "bold": true },
  "image": { "color": "#6B7A99", "underline": true },
  "image_text": { "color": "#6B7A99", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#1B8E1B" },
  "code_block": {
    "margin": 1,
    "chroma": {
      "text": {}, "error": { "color": "#F1F1F1", "background_color": "#F05B5B" },
      "comment": { "color": "#6B7A99" }, "comment_preproc": { "color": "#6B7A99" },
      "keyword": { "color": "#1B8E1B", "bold": true }, "keyword_reserved": { "color": "#1B8E1B" },
      "keyword_namespace": { "color": "#1B8E1B" }, "keyword_type": { "color": "#2F7DE1" },
      "operator": {}, "punctuation": {}, "name": {}, "name_builtin": { "color": "#2F7DE1" },
      "name_tag": { "color": "#1B8E1B" }, "name_attribute": { "color": "#2F7DE1" },
      "name_class": { "color": "#2F7DE1" }, "name_constant": { "color": "#D98E04" },
      "name_decorator": { "color": "#D98E04" }, "name_exception": { "color": "#F05B5B" },
      "name_function": { "color": "#2F7DE1" }, "name_other": {},
      "literal": { "color": "#D98E04" }, "literal_number": { "color": "#D98E04" },
      "literal_date": { "color": "#D98E04" }, "literal_string": { "color": "#D98E04" },
      "literal_string_escape": { "color": "#D98E04" }, "generic_deleted": { "color": "#F05B5B" },
      "generic_emph": { "italic": true }, "generic_inserted": { "color": "#1B8E1B" },
      "generic_strong": { "bold": true }, "generic_subheading": { "color": "#6B7A99" },
      "background": {}
    }
  },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {}, "definition_term": {}, "definition_description": { "block_prefix": "\n→ " },
  "html_block": {}, "html_span": {}
}
